<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <!-- Carretera Dibujada -->
  <com.example.arcaderacing.racing.RoadView
      android:id="@+id/road"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"/>

  <!-- 🔥 CRONÓMETRO / SCORE DE TIEMPO -->
  <TextView
      android:id="@+id/txtTimerScore"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Tiempo: 0"
      android:textSize="26sp"
      android:textStyle="bold"
      android:textColor="#FFFFFF"
      android:shadowColor="#000000"
      android:shadowRadius="6"
      android:layout_margin="24dp"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"/>

  <Button
      android:id="@+id/btnFlash"
      android:layout_width="80dp"
      android:layout_height="80dp"
      android:background="@drawable/flashmg"
      android:backgroundTint="@null"
      android:elevation="100dp"
      android:layout_margin="24dp"
      android:layout_marginBottom="380dp"
      android:text=""
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  <!-- Coche del jugador -->
  <ImageView
      android:id="@+id/car"
      android:layout_width="80dp"
      android:layout_height="128dp"
      android:src="@drawable/car1"
      android:layout_marginBottom="60dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"/>

  <ImageView
      android:id="@+id/flashEffect"
      android:layout_width="140dp"
      android:layout_height="140dp"
      android:src="@drawable/flash"
      android:visibility="gone"
      app:layout_constraintBottom_toTopOf="@id/car"
      app:layout_constraintStart_toStartOf="@id/car"
      app:layout_constraintEnd_toEndOf="@id/car"/>

</androidx.constraintlayout.widget.ConstraintLayout>
